function cmp(section1,section2) {
  let first = section1.split('.');
  let second = section2.split('.');

  for (let i = 0; i < Math.max(first.length, second.length); i++) {
    let s1 = +first[i] || 0;
    let s2 = +second[i] || 0;
    if (s1 > s2) return 1;
    else if (s2 > s1) return -1;
  }
  return 0;
}
