function routes(n){
  let result = (arr) =>arr.reduce((a, b) => a * b,1);
  if (n < 1) return 0
  let arr = [];
  for (let i = n + 1; i < 2 * n + 1; i++){
    arr.push(i);
  }
  let arr2 = [];
  for (let i = 1; i < n + 1; i++){
    arr2.push(i);
  }
  return Math.round(result(arr) / result(arr2));
}
